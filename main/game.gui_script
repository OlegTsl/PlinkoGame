local game_config      = require("config.game_config")
local build_config     = require("config.build_config")
local physics_data     = require("data.physics_data")
local motion_data      = require("data.motion_data")
local runtime_data     = require("data.runtime_data")
local ui_data          = require("data.ui_data")
local game_controller  = require("game.application.game_controller")
local game_manager     = require("game.application.game_manager")
local game_state       = require("game.state.game_state")
local ball_view        = require("game.views.ball_view")
local audio_view       = require("game.views.audio_view")
local stat_view        = require("game.views.stat_view")
local hud_view         = require("game.views.hud_view")
local level_builder    = require("game.builders.level_builder")
local viewport         = require("core.render.viewport")
local cheats_view      = require("game.views.cheats_view")
local storage          = require("game.infrastructure.storage")
local config_validator = require("game.validation.config_validator")

local DESIGN_WIDTH  = 560
local DESIGN_HEIGHT = 780
local TOGGLE_DEBUG_STATISTICS = hash("toggle_debug_statistics")

local function show_error(message)
	print("ERROR: " .. message)
	local status = gui.get_node("status_label")
	gui.set_text(status, message)
	gui.set_color(status, vmath.vector4(1, 0.25, 0.25, 1))
end

local function apply_events(self, events)
	if not events then
		return
	end
	ball_view.apply_events(self.ball_view, events)
	for index = 1, #events do
		local event = events[index]
		if event.type == "ball_spawned" or event.type == "spawn_pending" then
			hud_view.show_bucket(self.hud, event.target_bucket, event.type == "spawn_pending")
			print("Selected bucket: " .. event.target_bucket)
		elseif event.type == "pin_hit" then
			audio_view.play_collision(self.audio)
		elseif event.type == "ball_landed" then
			level_builder.play_score_pop(self.level_builder, event.target_bucket)
			audio_view.play_collect(self.audio)
			hud_view.set_score(self.hud, event.score)
		elseif event.type == "motion_error" then
			hud_view.show_error(self.hud, event.message)
			print(event.message)
		end
	end
end

function init(self)
	local valid, validation_error = config_validator.validate(
		game_config,
		physics_data,
		motion_data,
		runtime_data,
		ui_data
	)
	if not valid then
		show_error(validation_error)
		return
	end
	local wall_now = os.time()
	local state  = game_state.create(#game_config.baskets.items)
	self.manager = game_manager.create(game_config, state, wall_now, storage.create())
	self.deadline_reached = function() return os.clock() >= self.preparation_deadline end
	self.paused = false
	self.show_debug_statistics = false
	self.debug_statistics = stat_view.create()
	self.audio = audio_view.create()
	self.statistics_output = { hits = {}, percentages = {} }
	self.cheats = cheats_view.create(build_config.DEV_CHEATS)

	self.level_builder = level_builder.create()
	local limits = {
		min_baskets = game_config.level.min_basket_count,
		max_baskets = game_config.level.max_basket_count,
	}
	local layout, error_message = level_builder.build(self.level_builder, {
		basket_count = #game_config.baskets.items,
		basket_items = game_config.baskets.items,
		limits = limits,
	}, physics_data, runtime_data.max_active_balls, ui_data.wave.pool_size)
	if not layout then
		show_error(error_message)
		return
	end

	self.layout = layout
	self.controller, error_message = game_controller.create(
		game_config,
		physics_data,
		motion_data,
		runtime_data,
		layout,
		self.manager
	)
	if not self.controller then
		show_error(error_message)
		return
	end
	self.ball_view = ball_view.create(layout, physics_data, ui_data)
	local inventory = self.manager:refresh_balls(wall_now)
	self.hud = hud_view.create(
		self.manager:get_score(),
		inventory.balls,
		self.manager:get_ball_limit(),
		inventory.seconds_to_next
	)
	self.viewport = viewport.create(
		gui.get_node("content_root"),
		gui.get_node("screen_background"),
		DESIGN_WIDTH,
		DESIGN_HEIGHT
	)
	viewport.update(self.viewport)
	local status = gui.get_node("status_label")
	gui.set_text(status, "Press Play")
	gui.set_color(status, vmath.vector4(1, 1, 1, 1))
	msg.post(".", "acquire_input_focus")
	window.set_listener(function(_, event)
		if event == window.WINDOW_EVENT_FOCUS_LOST then
			self.paused = true
			hud_view.cancel_press(self.hud)
			cheats_view.cancel_input(self.cheats)
			local saved, message = self.manager:save()
			if not saved then print("Save failed on focus loss: " .. message) end
		end
		if event == window.WINDOW_EVENT_FOCUS_GAINED then self.paused = false end
	end)
end

function update(self, dt)
	if self.restarting then return end
	if self.audio then audio_view.update(self.audio, dt) end
	if self.hud and self.cheats and self.cheats.enabled then
		local actions = cheats_view.draw(self.cheats)
		for index = 1, #actions do
			local action = actions[index]
			if action and action.type == "add_balls" then
				local balls = self.manager:add_balls(action.count)
				hud_view.set_inventory(self.hud, balls, self.manager:get_ball_limit(), 0)
			elseif action and action.type == "reset_progress" then
				local reset, error_message = self.manager:reset_progress(os.time())
				if not reset then
					hud_view.show_error(self.hud, error_message)
				else
					self.restarting = true
					sys.reboot()
					return
				end
			end
		end
	end
	if self.controller and not self.paused then
		local step = math.min(math.max(dt, 0), runtime_data.max_visual_step)
		ball_view.update(self.ball_view, step)
		self.preparation_deadline = os.clock() + motion_data.preparation_budget_ms / 1000
		apply_events(self, self.controller:update(step, self.deadline_reached))
	end
	if self.manager then
		local inventory, save_error = self.manager:update(os.time())
		if save_error ~= self.save_error then
			self.save_error = save_error
			if save_error then
				print("Save failed: " .. save_error)
				if self.hud then hud_view.show_error(self.hud, "Save failed: " .. save_error) end
			end
		end
		if self.hud then
			hud_view.set_inventory(
				self.hud,
				inventory.balls,
				self.manager:get_ball_limit(),
				inventory.seconds_to_next
			)
		end
		if self.show_debug_statistics then
			stat_view.draw(self.debug_statistics, self.manager:get_statistics(self.statistics_output))
		end
	end
	if self.hud then
		hud_view.update(self.hud, dt)
	end
	if self.viewport then
		viewport.update(self.viewport)
	end
end

function on_input(self, action_id, action)
	if self.restarting or not self.controller or not self.hud or self.paused then
		return false
	end
	if build_config.DEV_CHEATS
		and action_id == TOGGLE_DEBUG_STATISTICS
		and action.pressed then
		self.show_debug_statistics = not self.show_debug_statistics
		stat_view.set_visible(
			self.debug_statistics,
			self.show_debug_statistics
		)
		return true
	end
	if cheats_view.on_input(self.cheats, action_id, action) then
		hud_view.cancel_press(self.hud)
		return true
	end
	local action_name = hud_view.on_input(self.hud, action_id, action)
	if action_name == "spawn" or action_name == "spawn_many" then
		local wall_now = os.time()
		local events, error_message = self.controller:request(action_name, wall_now)
		if not events then
			local inventory = self.manager:refresh_balls(wall_now)
			hud_view.set_inventory(self.hud, inventory.balls,
				self.manager:get_ball_limit(), inventory.seconds_to_next)
			hud_view.show_error(self.hud, error_message)
		else
			local inventory = self.manager:refresh_balls(wall_now)
			hud_view.set_inventory(self.hud, inventory.balls,
				self.manager:get_ball_limit(), inventory.seconds_to_next)
			apply_events(self, events)
		end
		return true
	end
	return false
end

function final(self)
	window.set_listener(nil)
	if self.ball_view then
		ball_view.destroy(self.ball_view)
	end
	level_builder.destroy(self.level_builder)
	if self.manager then
		local saved, message = self.manager:final()
		if not saved then print("Save failed on shutdown: " .. message) end
	end
	if self.debug_statistics then
		stat_view.destroy(self.debug_statistics)
	end
	self.layout        = nil
	self.controller    = nil
	self.manager       = nil
	self.viewport      = nil
	self.ball_view     = nil
	self.audio         = nil
	self.hud           = nil
	self.paused        = nil
	self.level_builder = nil
	self.cheats        = nil
	self.show_debug_statistics = nil
	self.debug_statistics = nil
	self.statistics_output = nil
	self.deadline_reached = nil
end
