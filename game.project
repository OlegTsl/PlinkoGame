[project]
title = Plinko Game
version = 0.1.0

[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[display]
width = 560
height = 780
high_dpi = 1

[html5]
scale_mode = Stretch
heap_size = 64
cssfile = /builtins/manifests/web/dark_theme.css
retry_count = 1000

[engine]
fixed_update_frequency = 60
max_time_step = 0.05

[physics]
gravity_y = -1000.0
scale = 0.01
velocity_threshold = 100.0
use_fixed_timestep = 1
max_fixed_timesteps = 0

[input]
game_binding = /input/game.input_bindingc

[script]
shared_state = 1

[render]
default_clear_color_red = 0.055
default_clear_color_green = 0.106
default_clear_color_blue = 0.176
default_clear_color_alpha = 1.0

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear
