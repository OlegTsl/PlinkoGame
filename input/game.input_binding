# Shared pointer action for desktop clicks and mobile touches.
mouse_trigger {
  input: MOUSE_BUTTON_LEFT
  action: "pointer"
}
touch_trigger {
  input: TOUCH_MULTI
  action: "pointer"
}
key_trigger {
  input: KEY_BACKQUOTE
  action: "toggle_debug_statistics"
}
key_trigger {
  input: KEY_TILDE
  action: "toggle_debug_statistics"
}
